{
  "$id": "https://frog-game-v2.local/schemas/map-theme/source-bundle-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "revisionId", "files"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "requestId": { "$ref": "common-v1.schema.json#/$defs/id" },
    "revisionId": { "$ref": "common-v1.schema.json#/$defs/id" },
    "files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "path", "mediaType", "sha256"],
        "properties": {
          "role": { "enum": ["source-design", "composite-preview", "clean-environment-plate", "semantic-overlay"] },
          "path": { "$ref": "common-v1.schema.json#/$defs/path" },
          "mediaType": { "type": "string", "pattern": "^[a-z]+/[a-z0-9.+-]+$" },
          "sha256": { "$ref": "common-v1.schema.json#/$defs/hash" }
        }
      }
    }
  }
}
