{
  "$id": "https://frog-game-v2.local/schemas/map-theme/review-evidence-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "packageId", "revisionId", "entries"],
  "properties": {
    "schemaVersion": { "const": 1 }, "packageId": { "$ref": "common-v1.schema.json#/$defs/id" }, "revisionId": { "$ref": "common-v1.schema.json#/$defs/id" },
    "entries": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["role", "path", "mediaType", "sha256"], "properties": { "role": { "enum": ["viewport-preview", "visual-diff", "asset-size-report", "protected-element-report", "accessibility-motion-report", "performance-report", "deviation-list"] }, "path": { "$ref": "common-v1.schema.json#/$defs/path" }, "mediaType": { "type": "string", "pattern": "^[a-z]+/[a-z0-9.+-]+$" }, "sha256": { "$ref": "common-v1.schema.json#/$defs/hash" } } } }
  }
}
