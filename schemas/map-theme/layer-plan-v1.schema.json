{
  "$id": "https://frog-game-v2.local/schemas/map-theme/layer-plan-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "revisionId", "layers"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "requestId": { "$ref": "common-v1.schema.json#/$defs/id" },
    "revisionId": { "$ref": "common-v1.schema.json#/$defs/id" },
    "layers": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["id", "role", "sourceRegionIds"], "properties": { "id": { "$ref": "common-v1.schema.json#/$defs/id" }, "role": { "enum": ["far-environment", "water-base", "underwater-texture", "edge-vegetation", "background-atmosphere", "foreground-weather", "landmark-backdrop"] }, "sourceRegionIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common-v1.schema.json#/$defs/id" } } } } }
  }
}
