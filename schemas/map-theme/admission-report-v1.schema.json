{
  "$id": "https://frog-game-v2.local/schemas/map-theme/admission-report-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "revisionId", "submissionClass", "workflowState", "score", "hardGates", "createdAt"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "requestId": { "$ref": "common-v1.schema.json#/$defs/id" },
    "revisionId": { "$ref": "common-v1.schema.json#/$defs/id" },
    "submissionClass": { "enum": ["REFERENCE_ONLY", "ANALYZABLE_CONCEPT", "IMPORT_CANDIDATE"] },
    "workflowState": { "enum": ["RECEIVED", "ANALYZED", "PROPOSED", "APPROVED", "REJECTED", "BUILT", "VALIDATED", "IMPORTED"] },
    "score": { "type": "number", "minimum": 0, "maximum": 100 },
    "hardGates": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["id", "passed"], "properties": { "id": { "type": "string", "minLength": 1 }, "passed": { "type": "boolean" } } } },
    "createdAt": { "type": "string", "format": "date-time" }
  }
}
