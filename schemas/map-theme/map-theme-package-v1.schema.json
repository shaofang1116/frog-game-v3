{
  "$id": "https://frog-game-v2.local/schemas/map-theme/map-theme-package-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "packageId", "displayName", "sourceEvidence", "compatibility", "viewport", "palette", "layers", "ambience", "exclusionZones", "semanticBindings", "protectedElements", "budgets", "fallback"],
  "properties": {
    "schemaVersion": { "const": 1 }, "packageId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }, "displayName": { "type": "string", "minLength": 1 },
    "sourceEvidence": { "type": "object", "additionalProperties": false, "required": ["revisionId", "sourceBundleHash", "briefHash", "provenanceId", "provenanceHash", "mappingApprovalHash", "rightsStatus"], "properties": { "revisionId": { "$ref": "common-v1.schema.json#/$defs/id" }, "sourceBundleHash": { "$ref": "common-v1.schema.json#/$defs/hash" }, "briefHash": { "$ref": "common-v1.schema.json#/$defs/hash" }, "provenanceId": { "$ref": "common-v1.schema.json#/$defs/id" }, "provenanceHash": { "$ref": "common-v1.schema.json#/$defs/hash" }, "mappingApprovalHash": { "$ref": "common-v1.schema.json#/$defs/hash" }, "rightsStatus": { "type": "string", "minLength": 1 } } },
    "compatibility": { "type": "object", "additionalProperties": false, "required": ["rendererVersion", "elementLibraryVersion"], "properties": { "rendererVersion": { "type": "string", "minLength": 1 }, "elementLibraryVersion": { "type": "string", "minLength": 1 } } },
    "viewport": { "type": "object", "additionalProperties": false, "required": ["aspectRatio", "logicalWidth", "logicalHeight", "cameraModel", "safeZones"], "properties": { "aspectRatio": { "type": "string", "pattern": "^[0-9]+:[0-9]+$" }, "logicalWidth": { "type": "integer", "minimum": 1 }, "logicalHeight": { "type": "integer", "minimum": 1 }, "cameraModel": { "enum": ["top-down", "near-orthographic"] }, "safeZones": { "type": "array", "minItems": 1, "items": { "$ref": "common-v1.schema.json#/$defs/normalizedRect" } } } },
    "palette": { "type": "object", "additionalProperties": false, "required": ["water", "reflection", "weather", "atmosphere"], "properties": { "water": { "type": "string" }, "reflection": { "type": "string" }, "weather": { "type": "string" }, "atmosphere": { "type": "string" } } },
    "layers": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "role", "zBand", "asset", "blendMode", "opacity", "parallax", "motion", "exclusionPolicy"], "properties": { "id": { "$ref": "common-v1.schema.json#/$defs/id" }, "role": { "enum": ["far-environment", "water-base", "underwater-texture", "edge-vegetation", "background-atmosphere", "foreground-weather", "landmark-backdrop"] }, "zBand": { "type": "integer", "minimum": 0 }, "asset": { "$ref": "common-v1.schema.json#/$defs/path" }, "blendMode": { "enum": ["source-over", "multiply", "screen", "overlay", "lighter"] }, "opacity": { "type": "number", "minimum": 0, "maximum": 1 }, "parallax": { "type": "number", "minimum": 0, "maximum": 1 }, "motion": { "type": "object", "additionalProperties": false, "required": ["maxInstances"], "properties": { "maxInstances": { "type": "integer", "minimum": 0, "maximum": 48 } } }, "exclusionPolicy": { "enum": ["avoid-gameplay", "edge-only", "none"] } } } },
    "ambience": { "type": "object" }, "exclusionZones": { "type": "array", "items": { "$ref": "common-v1.schema.json#/$defs/normalizedRect" } }, "semanticBindings": { "type": "array" },
    "protectedElements": { "type": "object", "additionalProperties": false, "required": ["frog.player", "surface.lily-pad.normal", "surface.lily-pad.sinking", "hazard.crocodile", "hazard.crocodile.warning-wake", "reward.flower", "reward.golden-lotus", "item.bomb", "item.bomb-pickup", "preview.jump-target", "ui.hud", "ui.control.dpad", "ui.control.bomb"], "properties": { "frog.player": { "const": "inherit-only" }, "surface.lily-pad.normal": { "const": "inherit-only" }, "surface.lily-pad.sinking": { "const": "inherit-only" }, "hazard.crocodile": { "const": "inherit-only" }, "hazard.crocodile.warning-wake": { "const": "inherit-only" }, "reward.flower": { "const": "inherit-only" }, "reward.golden-lotus": { "const": "inherit-only" }, "item.bomb": { "const": "inherit-only" }, "item.bomb-pickup": { "const": "inherit-only" }, "preview.jump-target": { "const": "inherit-only" }, "ui.hud": { "const": "inherit-only" }, "ui.control.dpad": { "const": "inherit-only" }, "ui.control.bomb": { "const": "inherit-only" } } },
    "budgets": { "type": "object", "additionalProperties": false, "required": ["compressedBytes", "drawCalls", "visibleInstances", "motionInstances"], "properties": { "compressedBytes": { "type": "integer", "minimum": 0 }, "drawCalls": { "type": "integer", "minimum": 0 }, "visibleInstances": { "type": "integer", "minimum": 0, "maximum": 24 }, "motionInstances": { "type": "integer", "minimum": 0, "maximum": 48 } } },
    "fallback": { "type": "object", "additionalProperties": false, "required": ["presetId", "color", "density"], "properties": { "presetId": { "type": "string", "minLength": 1 }, "color": { "type": "string" }, "density": { "type": "number", "minimum": 0, "maximum": 1 } } }
  }
}
