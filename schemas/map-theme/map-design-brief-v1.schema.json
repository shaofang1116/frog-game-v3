{
  "$id": "https://frog-game-v2.local/schemas/map-theme/map-design-brief-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "mapId", "displayName", "designPurpose", "chapterRole", "sourceType", "targetViewport", "cameraModel", "gameplayCorridor", "safeZones", "themeKeywords", "backgroundIntent", "canonicalElements", "newElementProposals", "motionIntent", "prohibitedChanges", "provenance"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "requestId": { "$ref": "common-v1.schema.json#/$defs/id" },
    "mapId": { "$ref": "common-v1.schema.json#/$defs/id" },
    "displayName": { "type": "string", "minLength": 1 },
    "designPurpose": { "type": "string", "minLength": 1 },
    "chapterRole": { "type": "string", "minLength": 1 },
    "sourceType": { "type": "string", "minLength": 1 },
    "targetViewport": { "type": "object", "additionalProperties": false, "required": ["width", "height"], "properties": { "width": { "type": "integer", "minimum": 1 }, "height": { "type": "integer", "minimum": 1 } } },
    "cameraModel": { "enum": ["top-down", "near-orthographic"] },
    "gameplayCorridor": { "$ref": "common-v1.schema.json#/$defs/normalizedRect" },
    "safeZones": { "type": "array", "minItems": 1, "items": { "$ref": "common-v1.schema.json#/$defs/normalizedRect" } },
    "themeKeywords": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "backgroundIntent": { "type": "string", "minLength": 1 },
    "canonicalElements": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "position"], "properties": { "id": { "type": "string", "minLength": 1 }, "position": { "$ref": "common-v1.schema.json#/$defs/normalizedRect" } } } },
    "newElementProposals": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "motionIntent": { "type": "string", "minLength": 1 },
    "prohibitedChanges": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "provenance": { "type": "object", "additionalProperties": false, "required": ["provenanceId", "provenanceHash"], "properties": { "provenanceId": { "$ref": "common-v1.schema.json#/$defs/id" }, "provenanceHash": { "$ref": "common-v1.schema.json#/$defs/hash" } } }
  }
}
